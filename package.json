{
  "name": "second-brain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node --env-file=.env scripts/sync.mjs",
    "graph": "node scripts/build-graph.mjs",
    "build-data": "npm run sync && npm run graph",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build-data && npx vercel build --prod && npx vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.25.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  }
}
